# Copy to .env.local. Every key the app and its scripts read is listed here;
# the shape of each value is stated in its comment. Server-only keys never
# reach the browser bundle — only NEXT_PUBLIC_* does.
#
# Alchemy apps are multi-network: one key serves eth-mainnet, base-mainnet and
# eth-sepolia on different hosts. ALCHEMY_URL, BASE_RPC_URL and SEPOLIA_RPC_URL
# can all be the same key on the matching host; no second account or plan.

# ───────────────────────── Runtime — the Next app ─────────────────────────

# Required.

# Base URL of the live indexed backend (https://host[:port]); every
# /api/<proto>/* route and SSR loader reads history and reduced state from it.
RAILS_API_URL=

# Bearer token the app sends to RAILS_API_URL; also the HMAC key that signs the
# reader-IP hop header. Unset ⇒ requests go out unauthenticated and are refused.
API_BEARER_TOKEN=

# Ethereum mainnet JSON-RPC URL (an Alchemy eth-mainnet endpoint) — the
# chain-overlay live eth_call reads and the mainnet eth_getLogs history sweeps.
# A deployment that serves any Ethereum explorer needs it; unset throws on first
# chain read rather than pricing from the wrong network.
ALCHEMY_URL=

# Base (chain 8453) JSON-RPC — the Basedollar branch PriceFeeds, live trove
# reads and Basenames resolution. Alchemy apps are multi-network, so this is the
# ALCHEMY_URL key on the base-mainnet host; no second account or plan. Unset,
# Basedollar rows render amounts-only with no USD, no error and nothing that
# looks broken — so any deployment that serves /basedollar wants it, preview
# included.
BASE_RPC_URL=

# Wide-range eth_getLogs endpoint for Base — the whole-life history sweeps
# (Base vault timelines and allocation reads). Deliberately separate from
# BASE_RPC_URL: the two are different products on the same chain. Alchemy's
# free tier serves a full eth_call archive on Base and caps eth_getLogs at TEN
# blocks, so a history sweep run through it reads no history at all rather
# than a short one; a metered (pay-as-you-go) Alchemy base-mainnet URL answers
# a whole-life sweep. Unset ⇒ the Base timelines state that they are
# unavailable, which is the right failure — an empty timeline and a missing
# endpoint must never look the same.
# (BASE_LOGS_RPC_URL was this lane until 2026-09-19; nothing reads it now.)
BASE_BACKFILL_RPC_URL=

# The deployment's own canonical hostname — every canonical, OG url and sitemap
# entry is built from it. Unset, it falls through to VERCEL_URL, which is a
# different per-deployment hash on every push.
NEXT_PUBLIC_SITE_URL=

# Optional.

# Sepolia (chain 11155111) JSON-RPC URL — state reads and getLogs sweeps for
# the testnet explorers. Unset, it is derived from ALCHEMY_URL by swapping the
# host (Alchemy endpoints only).
SEPOLIA_RPC_URL=

# Ethereum mainnet wide-range eth_getLogs endpoint. Today the mainnet sweeps
# run through ALCHEMY_URL; the vault route only reports whether this lane is
# configured. Set it when a separate metered mainnet logs endpoint exists.
ETHEREUM_LOGS_RPC_URL=

# Ethereum mainnet JSON-RPC URL used for ENS reverse lookups. Unset, the app
# falls back across public endpoints.
ENS_RPC_URL=

# Telegram bot token (from BotFather, "123456:ABC-…") and the numeric chat id
# the footer feedback route posts to. Unset, /api/feedback reports that it is
# not configured; nothing else is affected.
TELEGRAM_BOT_TOKEN=
TELEGRAM_FEEDBACK_CHAT_ID=

# Prefix for the browser-side session keys (the remembered wallet pill).
# Defaults to "liquity-v2"; set it when two deployments share one origin and
# must not inherit each other's wallet.
NEXT_PUBLIC_SESSION_SCOPE=

# NEXT_PUBLIC_SITE_SCOPE was removed in f199460f and is documented here no
# longer: nothing in the tree reads it, and the guard this block described — a
# scoped production build refusing to run on a mismatched hostname — does not
# exist. Setting it does nothing. Whether a surface is reachable is the roster's
# `unlaunched` flag (lib/shared/protocols.ts), and what is launched is
# rails-ops/decisions/0030.

# ─────────────── Scripts and verifiers — local only, never deployed ───────────────
#
# The chain verifiers (scripts/verify-*-chain.mjs, scripts/verify/*) read
# ALCHEMY_URL, BASE_RPC_URL, BASE_BACKFILL_RPC_URL, SEPOLIA_RPC_URL,
# ETHEREUM_LOGS_RPC_URL, ENS_RPC_URL, RAILS_API_URL and API_BEARER_TOKEN from
# the block above (each script's header names the ones it needs). The keys
# below are read by scripts only. All optional.

# Etherscan API key — the Frankencoin chain verifier's contract-source check
# and the vault census naming pass; each skips when it is unset.
ETHERSCAN_API_KEY=

# Base JSON-RPC URL for scripts/generate-pt-underlying.mjs; falls back to
# BASE_RPC_URL.
ALCHEMY_BASE_URL=

# Read-only shell command that takes psql input on stdin and prints rows; the
# verifiers that read the index's tables skip those checks when it is unset.
RAILS_OPS_PSQL_READ=

# Local checkout path of the backend repo, for the verifiers that read its
# source; defaults to the sibling directory of this checkout.
SERVER_REPO=

# Directories the census and probe scripts write their runs to; default to a
# folder under the system temp directory.
OUT_DIR=
SCREENSHOT_DIR=

# Directory of recorded Polaris fixtures for verify-polaris-chain.mjs
# (--fixtures); unset, the verifier runs against the live chain.
POLARIS_FIXTURES_DIR=

# Shell command verify-queued-export.mjs runs to restart the server between
# arms; unset, the restart arm is skipped.
RESTART_CMD=

# Origin (https://host) verify-vault-tail-ceiling.mjs measures against.
TAIL_BASE=

# Upstream JSON-RPC URL and listen port for scripts/verify/rpc-counting-proxy.mjs.
UPSTREAM=
PORT=

# Per-run selectors and knobs, passed inline on the command line
# (`ONLY=timeline JOBS=2 node scripts/verify/run-all.mjs`), not set here:
# ONLY, JOBS, MEASURE, FIXTURES, VERBOSE, BROWSER, BREAK, BURST, ARM, CPU,
# GAP_MS, TIMEOUT_MS, RUNS, ROWS, RECENT, SAMPLE, PAGE, PAGE_SIZE, PAGE_PATH,
# PROTO, PROTOS, PROTOCOL, FAMILY, FAMILIES, FORK, MARKET, NET, BASE, WALLET,
# CONTROL, EXPLORER, NFTS, TENURE, SHOT, FILE, FORMAT_ONLY, FLOOR_STUBBED,
# LIFETIME_RE, QUEUED, API_PARAMS, BASE_V3_WALLET_PATH, PROBE_ROOT,
# PROBE_HOOK, PROBE_STUBS, VERIFY_RPC_OVERRIDE, VERIFY_EXPORT_REFUSAL_ARM.
