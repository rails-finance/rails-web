{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["scripts/**/*.mjs", "scripts/verify/**/*.mjs"],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "types/**/*.{ts,tsx}",
    "scripts/**/*.mjs"
  ],
  "ignoreDependencies": ["tailwindcss"],
  "ignoreBinaries": ["pgrep"],
  "ignoreExportsUsedInFile": true
}
