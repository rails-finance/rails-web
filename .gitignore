# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json
.claude
.playwright-mcp/*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
server.sh
reference/*
.zip.py
rails*.zip
app/(site)/blog/README.md

# Slideshow demo tool (lives in slideshow-tool branch only, never merge to main)
slideshow/
app/api/slideshow/
app/slideshow-dev/
SLIDESHOW-BRANCH-SETUP.md
scripts/.redemption-progress copy.json
scripts/.redemption-progress.json
scripts/redemption-events.csv
scripts/redemption-results.json
scripts/redemption-stats.mjs

# Session verification artifacts. The repo ROOT is scratch space: a verifier written
# to prove one change and then discarded lives here and stays out of history.
#
# A verifier worth keeping — one that guards a behaviour rather than a single edit —
# belongs in `scripts/verify/`, which these rules do not match (they are anchored to
# the root by the leading slash). Move it there and `git add` it explicitly; don't
# force-add it at the root, or the next reader can't tell scratch from guard.
/verify-*
/probe-*
/runcard-*

# Scratch playwright/SQL probes living beside the verify suite — session tools,
# never committed (their durable siblings live in scripts/verify/, added by name).
/scripts/.probe-*
